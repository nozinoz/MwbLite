<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Kept so upstream's InternalsVisibleTo("MouseWithoutBorders.UnitTests") applies unchanged. -->
    <AssemblyName>MouseWithoutBorders.UnitTests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Core\Logger.PrivateDump.expected.txt" />
    <None Remove="Core\Logger.PrivateDump.original.txt" />
    <EmbeddedResource Include="Core\Logger.PrivateDump.expected.txt" />
    <EmbeddedResource Include="Core\Logger.PrivateDump.original.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App\MwbLite.csproj" />
  </ItemGroup>
</Project>
