<?xml version="1.0" encoding="utf-8"?>
<!--
  MwbLite Setup theme for the WiX standard bootstrapper application (thmutil). Based on WiX 5.0.2's HyperlinkTheme.xml
  (src/ext/Bal/stdbas/Resources), Copyright (c) .NET Foundation and contributors, Microsoft Reciprocal License (see
  NOTICE.md); modified for MwbLite: larger window, banner image, Segoe UI Variable, a one-line licence link with an
  "I agree" box, a "Start MwbLite with Windows" box (Burn variable StartWithWindows), and plainer page text.
-->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
    <Font Id="0" Height="-14" Weight="400" Foreground="windowtext" Background="window">Segoe UI Variable Text</Font>
    <Font Id="1" Height="-26" Weight="600" Foreground="windowtext" Background="window">Segoe UI Variable Display</Font>
    <Font Id="2" Height="-14" Weight="400" Foreground="graytext" Background="window">Segoe UI Variable Text</Font>
    <Font Id="3" Height="-14" Weight="400" Foreground="windowtext" Background="window">Segoe UI Variable Text</Font>

    <Window Width="560" Height="400" HexStyle="100a0000" FontId="0" Caption="#(loc.Caption)">
        <ImageControl X="0" Y="0" Width="560" Height="100" ImageFile="banner.png" Visible="yes" />

        <Page Name="Help">
            <Label X="28" Y="124" Width="-28" Height="34" FontId="1" DisablePrefix="yes">#(loc.HelpHeader)</Label>
            <Label X="28" Y="168" Width="-28" Height="-64" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Label>
            <Button Name="HelpCloseButton" X="-28" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0">
                <Text>#(loc.HelpCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Loading">
            <Label X="28" Y="124" Width="-28" Height="34" FontId="2" DisablePrefix="yes" Visible="no" Name="CheckingForUpdatesLabel" />
        </Page>

        <Page Name="Install">
            <Label X="28" Y="124" Width="-28" Height="34" FontId="1" DisablePrefix="yes">#(loc.InstallHeader)</Label>
            <Label X="28" Y="164" Width="-28" Height="44" FontId="2" DisablePrefix="yes">#(loc.InstallMessage)</Label>
            <Checkbox Name="StartWithWindows" X="28" Y="220" Width="-28" Height="24" TabStop="yes" FontId="3">#(loc.InstallStartupCheckbox)</Checkbox>
            <Hypertext Name="EulaHyperlink" X="28" Y="-64" Width="-28" Height="22" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallLicenseLinkText)</Hypertext>
            <Checkbox Name="EulaAcceptCheckbox" X="28" Y="-20" Width="300" Height="28" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>
            <Button Name="InstallUpdateButton" X="28" Y="-100" Width="220" Height="32" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
            <Button Name="InstallButton" X="-132" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0">#(loc.InstallInstallButton)</Button>
            <Button Name="InstallCancelButton" X="-28" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0">
                <Text>#(loc.InstallCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Options">
            <Label X="28" Y="124" Width="-28" Height="34" FontId="1" DisablePrefix="yes">#(loc.OptionsHeader)</Label>
            <Label X="28" Y="168" Width="-28" Height="20" FontId="3" DisablePrefix="yes">#(loc.OptionsLocationLabel)</Label>
            <Editbox Name="InstallFolder" X="28" Y="192" Width="-132" Height="28" TabStop="yes" FontId="3" FileSystemAutoComplete="yes" />
            <Button Name="BrowseButton" X="-28" Y="190" Width="96" Height="32" TabStop="yes" FontId="3">
                <Text>#(loc.OptionsBrowseButton)</Text>
                <BrowseDirectoryAction VariableName="InstallFolder" />
            </Button>
            <Button Name="OptionsOkButton" X="-132" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0">
                <Text>#(loc.OptionsOkButton)</Text>
                <ChangePageAction Page="Install" />
            </Button>
            <Button Name="OptionsCancelButton" X="-28" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0">
                <Text>#(loc.OptionsCancelButton)</Text>
                <ChangePageAction Page="Install" Cancel="yes" />
            </Button>
        </Page>

        <Page Name="Progress">
            <Label X="28" Y="124" Width="-28" Height="34" FontId="1" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
            <Label Name="OverallProgressPackageText" X="28" Y="176" Width="-28" Height="22" FontId="2" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
            <Progressbar Name="OverallCalculatedProgressbar" X="28" Y="206" Width="-28" Height="8" />
            <Button Name="ProgressCancelButton" X="-28" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
        </Page>

        <Page Name="Modify">
            <Label X="28" Y="124" Width="-28" Height="34" FontId="1" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
            <Label X="28" Y="164" Width="-28" Height="44" FontId="2" DisablePrefix="yes">#(loc.ModifyMessage)</Label>
            <Button Name="ModifyUpdateButton" X="28" Y="-20" Width="220" Height="32" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
            <Button Name="RepairButton" X="-236" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.ModifyRepairButton)</Button>
            <Button Name="UninstallButton" X="-132" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0">#(loc.ModifyUninstallButton)</Button>
            <Button Name="ModifyCancelButton" X="-28" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0">
                <Text>#(loc.ModifyCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Success">
            <Label X="28" Y="124" Width="-28" Height="34" FontId="1" DisablePrefix="yes">
                <Text>#(loc.SuccessHeader)</Text>
                <Text Condition="WixBundleAction = 2">#(loc.SuccessLayoutHeader)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.SuccessUnsafeUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.SuccessUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 5">#(loc.SuccessCacheHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.SuccessInstallHeader)</Text>
                <Text Condition="WixBundleAction = 7">#(loc.SuccessModifyHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.SuccessRepairHeader)</Text>
            </Label>
            <Label X="28" Y="164" Width="-28" Height="66" FontId="2" DisablePrefix="yes" VisibleCondition="WixBundleAction = 6 OR WixBundleAction = 8">#(loc.SuccessInstallMessage)</Label>
            <Label X="28" Y="-64" Width="-28" Height="40" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">
                <Text>#(loc.SuccessRestartText)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallRestartText)</Text>
            </Label>
            <Button Name="LaunchButton" X="-132" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessLaunchButton)</Button>
            <Button Name="SuccessRestartButton" X="-132" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
            <Button Name="SuccessCloseButton" X="-28" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0">
                <Text>#(loc.SuccessCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Failure">
            <Label X="28" Y="124" Width="-28" Height="34" FontId="1" DisablePrefix="yes">
                <Text>#(loc.FailureHeader)</Text>
                <Text Condition="WixBundleAction = 2">#(loc.FailureLayoutHeader)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.FailureUnsafeUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.FailureUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 5">#(loc.FailureCacheHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.FailureInstallHeader)</Text>
                <Text Condition="WixBundleAction = 7">#(loc.FailureModifyHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.FailureRepairHeader)</Text>
            </Label>
            <Hypertext Name="FailureLogFileLink" X="28" Y="164" Width="-28" Height="44" FontId="3" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
            <Hypertext Name="FailureMessageText" X="28" Y="212" Width="-28" Height="60" FontId="2" TabStop="yes" HideWhenDisabled="yes" />
            <Label X="28" Y="-64" Width="-28" Height="40" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
            <Button Name="FailureRestartButton" X="-132" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
            <Button Name="FailureCloseButton" X="-28" Y="-20" Width="96" Height="32" TabStop="yes" FontId="0">
                <Text>#(loc.FailureCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
    </Window>
</Theme>
